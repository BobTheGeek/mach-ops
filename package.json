{
  "name": "mach-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mach Ops: Weapons-Grade Math — browser arcade flight game that teaches FSD Honors Math 7",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "curriculum": "tsx scripts/build-curriculum.ts",
    "mission": "tsx scripts/mission.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "ajv": "^8.17.1",
    "fast-check": "^3.19.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
