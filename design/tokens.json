        "sound": "low pass sweep down, 150 ms, world audio ducks",
        "haptic": null,
        "trigger": "card slides in"
      },
      "keyTick": {
        "sound": "click 4 ms, 1 kHz",
        "haptic": null,
        "trigger": "each digit typed or keypad tap"
      },
      "hit": {
        "sound": "confirm chirp 660\u2192990 Hz, 120 ms",
        "haptic": "20 ms",
        "trigger": "correct answer"
      },
      "hitFast": {
        "sound": "hit + shimmer tail 300 ms",
        "haptic": "20 ms \u00d72",
        "trigger": "correct inside fast ring"
      },
      "miss": {
        "sound": "flat buzz 180 Hz, 200 ms",
        "haptic": "60 ms",
        "trigger": "wrong answer; shield drain follows"
      },
      "shieldDrain": {
        "sound": "descending hiss 400 ms",
        "haptic": null,
        "trigger": "shield bar animates down"
      },
      "lockBreak": {
        "sound": "snap + static 240 ms",
        "haptic": null,
        "trigger": "reticle corners scatter"
      },
      "streakTick": {
        "sound": "pitch steps up one semitone per streak, cap at 12",
